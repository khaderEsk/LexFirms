:root {
    --gold: #C7A341;
    --dark-gold: #9C7C2C;
    --deep-green: #1E2723;
    --blackish: #0B0E0D;
    --error: #ff4757;
    --success: #2ed573;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    margin: 0;
    min-height: 100vh;
    background: linear-gradient(145deg, var(--blackish) 20%, var(--deep-green) 100%);
    display: flex;
    justify-content: center;
    align-items: center;
    font-family: 'Tajawal', sans-serif;
    color: var(--gold);
    padding: 20px;
}

.login-box {
    background: rgba(15, 18, 17, 0.95);
    border: 1px solid rgba(199, 163, 65, 0.3);
    border-radius: 20px;
    box-shadow: 0 0 60px rgba(199, 163, 65, 0.2);
    padding: 50px 40px;
    width: 100%;
    max-width: 420px;
    text-align: center;
    backdrop-filter: blur(12px);
    position: relative;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeIn 0.8s ease forwards;
}

.login-box::before {
    content: "";
    position: absolute;
    top: -2px;
    left: -2px;
    right: -2px;
    bottom: -2px;
    border-radius: 20px;
    background: linear-gradient(135deg, rgba(199, 163, 65, 0.5), rgba(156, 124, 44, 0.2));
    z-index: -1;
    opacity: 0.7;
}

.logo-container {
    margin-bottom: 30px;
    position: relative;
}

.login-box img {
    width: 160px;
    height: 160px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid rgba(199, 163, 65, 0.3);
    padding: 5px;
    background: rgba(15, 18, 17, 0.8);
    transition: all 0.3s ease;
    box-shadow: 0 0 30px rgba(199, 163, 65, 0.2);
}

.login-box img:hover {
    transform: scale(1.05);
    box-shadow: 0 0 40px rgba(199, 163, 65, 0.3);
}

h2 {
    font-family: 'Cinzel', serif;
    font-size: 1.8rem;
    color: var(--gold);
    margin-bottom: 35px;
    text-shadow: 0 0 10px rgba(199, 163, 65, 0.3);
}

label {
    display: block;
    text-align: right;
    font-size: 0.95rem;
    color: var(--gold);
    margin-bottom: 8px;
    font-weight: 500;
}

.input-group {
    position: relative;
    margin-bottom: 25px;
}

input {
    width: 100%;
    padding: 14px 50px 14px 14px;
    border-radius: 12px;
    border: 2px solid rgba(199, 163, 65, 0.3);
    background-color: rgba(255, 255, 255, 0.05);
    color: #fff;
    font-size: 1rem;
    transition: all 0.3s ease;
    font-family: 'Tajawal', sans-serif;
    height: 52px;
    line-height: 1.5;
}

input:focus {
    outline: none;
    border-color: var(--gold);
    box-shadow: 0 0 20px rgba(199, 163, 65, 0.4);
    background-color: rgba(255, 255, 255, 0.08);
    transform: translateY(-2px);
}

input::placeholder {
    color: rgba(255, 255, 255, 0.4);
    font-size: 0.9rem;
}

.input-icon {
    position: absolute;
    /* bottom: 50%;  */
    transform: translateY(-50%);
    color: var(--gold);
    font-size: 1.1rem;
}

.email-icon {
    left: 10px;
    bottom: 12%;
}

.toggle-password {
    position: absolute;
    left: 10px;
    top: 65%;
    transform: translateY(-50%);
    cursor: pointer;
    transition: color 0.3s ease;
    font-size: 1.1rem;
}

.toggle-password:hover {
    color: #e7c86a;
}

.remember-forgot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 25px;
    font-size: 0.9rem;
}

.remember-me {
    display: flex;
    align-items: center;
    gap: 8px;
}

.remember-me input {
    width: 16px;
    height: 16px;
    margin: 0;
}

.forgot-password {
    color: var(--gold);
    text-decoration: none;
    transition: color 0.3s ease;
}

.forgot-password:hover {
    color: #e7c86a;
    text-decoration: underline;
}

.btn {
    background: #0A1F1B;
    border: none;
    color: #0B0E0D;
    font-weight: bold;
    padding: 15px 0;
    border-radius: 12px;
    width: 100%;
    font-size: 1.05rem;
    cursor: pointer;
    transition: all 0.3s ease;
    font-family: 'Tajawal', sans-serif;
    position: relative;
    overflow: hidden;
    height: 52px;
}

.btn:hover {
    background: linear-gradient(135deg, #d8b44c, #a3842e);
    box-shadow: 0 0 25px rgba(199, 163, 65, 0.5);
    transform: translateY(-2px);
}

.btn:active {
    transform: translateY(0);
}

.footer-text {
    margin-top: 25px;
    font-size: 0.95rem;
    color: rgba(199, 163, 65, 0.9);
}

.footer-text a {
    color: var(--gold);
    text-decoration: none;
    font-weight: 500;
    transition: all 0.3s ease;
}

.footer-text a:hover {
    color: #e7c86a;
    text-decoration: underline;
}

/* رسائل الخطأ */
.alert {
    padding: 12px 15px;
    border-radius: 10px;
    margin-bottom: 20px;
    font-size: 0.9rem;
    text-align: right;
}

.alert-error {
    background-color: rgba(255, 71, 87, 0.1);
    border: 1px solid var(--error);
    color: var(--error);
}

.alert-success {
    background-color: rgba(46, 213, 115, 0.1);
    border: 1px solid var(--success);
    color: var(--success);
}

@keyframes fadeIn {
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes shake {

    0%,
    100% {
        transform: translateX(0);
    }

    25% {
        transform: translateX(-5px);
    }

    75% {
        transform: translateX(5px);
    }
}

.shake {
    animation: shake 0.4s ease;
}
